# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.php text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Export-ignore: Exclude files from distribution archives (composer archive, GitHub releases)
# These files are not needed when the package is installed via Composer

# Version control
.gitattributes export-ignore
.gitignore export-ignore

# CI/CD and testing
.github/ export-ignore
.phpunit.cache/ export-ignore
phpunit.xml export-ignore
.codecov.yml export-ignore

# Tests
tests/ export-ignore

# Legacy code (migration reference only)
legacy/ export-ignore

# Documentation
README.md export-ignore
.github/CONTRIBUTING.md export-ignore
.github/CI_SETUP.md export-ignore
.github/CODECOV_SETUP.md export-ignore

# IDE and editor files
.idea/ export-ignore
.vscode/ export-ignore
*.swp export-ignore
*.swo export-ignore
*~ export-ignore

# OS files
.DS_Store export-ignore
Thumbs.db export-ignore

# Development dependencies
.editorconfig export-ignore
