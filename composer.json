{
  "name": "horat1us/yii2-scheduling",
  "description": "Yii2 Scheduling",
  "type": "library",
  "require": {
    "yiisoft/yii2": "^2.0.52",
    "nesbot/carbon": "^3.8.4",
    "symfony/process": "^6.0||^7.0",
    "dragonmantank/cron-expression": "^3.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.4",
    "squizlabs/php_codesniffer": "^4.0",
    "horat1us/yii2-asset-free": "^1.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "horat1us",
      "email": "git-public@alias.horatius.dev"
    }
  ],
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Horat1us\\Yii\\Schedule\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Horat1us\\Yii\\Schedule\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "./vendor/bin/phpcs --standard=PSR12 ./src ./tests",
    "phpcbf": "./vendor/bin/phpcbf --standard=PSR12 ./src ./tests",
    "test": "./vendor/bin/phpunit"
  }
}
